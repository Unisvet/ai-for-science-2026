# ==============================================================================
# APAC AI for Science DevFest 2026 — AlphaEvolve & Antigravity on Google Cloud
# Attendee & Speaker Environment Template (.env.example)
# Copy this file to `.env` (root) and fill in your Google Cloud project values.
# Note: AlphaEvolve authenticates keylessly via Application Default Credentials
# (`gcloud auth application-default login`) — no GEMINI_API_KEY is needed here!
# All demos also include a zero-credential OFFLINE / PRERECORDED mode.
# ==============================================================================

# 1. Execution Mode ("prerecorded" for offline/attendee replay, "live" for GCP APIs)
DEMO_EXECUTION_MODE=prerecorded

# 2. Google Cloud & Gemini Enterprise AlphaEvolve (`ae` CLI & Discovery Engine API)
# Codelab: https://codelabs.developers.google.com/alphaevolve-on-google-cloud-1#0
# Repo:    https://github.com/Google-Cloud-AI/alphaevolve-on-googlecloud
# Authenticate first with: `gcloud auth application-default login`
PROJECT_ID=your-gcp-project-number-or-id
GE_APP_ID=your-gemini-enterprise-engine-id
LOCATION=global
COLLECTION=default_collection
ASSISTANT=default_assistant
BASE_URL=discoveryengine.googleapis.com

# --- Optional AlphaEvolve Tuning (`demos/alphaevolve_circle_packing/run_evolution.py`) ---
# Model mixture: leave MODEL_1 / MODEL_2 empty to use AlphaEvolve's default
# backend mixture, or specify explicit models (weights are normalized server-side).
# Examples: single fast explorer (`MODEL_1=gemini-4-argon`, `MODEL_1_WEIGHT=1.0`)
# or ensemble (`MODEL_1=gemini-4-hydrogen` 0.7 + `MODEL_2=gemini-4-argon` 0.3).
MODEL_1=gemini-4-argon
MODEL_2=
MODEL_1_WEIGHT=1.0
MODEL_2_WEIGHT=0.0

# Evaluation mode: False = sequential local eval; True = parallel worker pool
PARALLEL_EVALUATION=True

# Loop & concurrency budgets:
# - MAX_PROGRAMS_GENERATED / MAX_PROGRAMS_EVALUATED: total candidate budget per run
# - CONCURRENCY: parallel generation requests to Discovery Engine
# - WORKER_CONCURRENCY: local parallel worker processes when PARALLEL_EVALUATION=True
# - IDLE_TIMEOUT_S: seconds to wait before stopping if no new candidates arrive
# - EVAL_TIMEOUT_S: hard per-candidate runtime limit (seconds) in `evaluate.py`
MAX_PROGRAMS_GENERATED=30
MAX_PROGRAMS_EVALUATED=30
CONCURRENCY=4
WORKER_CONCURRENCY=4
IDLE_TIMEOUT_S=300
EVAL_TIMEOUT_S=20

# 3. Antigravity 2.0 SDK Configuration (`uv add google-antigravity`)
# Docs: https://antigravity.google/docs & https://github.com/google-antigravity/antigravity-sdk-python
AGY_SANDBOX_MODE=proceed-in-sandbox
AGY_MAX_PARALLEL_SUBAGENTS=3

# 4. Zero-Leak Ephemeral Spot Cloud TPU Target (`scripts/run_alphaevolve_spot_tpu.sh`)
GCP_TPU_NAME=alphaevolve-tpu
GCP_TPU_ZONE=europe-west4-a
GCP_TPU_TYPE=v6e-1
GCP_TPU_VERSION=v2-alpha-tpuv6e
TORCH_TPU_DEVICE=tpu:0
